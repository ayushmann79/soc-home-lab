# /etc/network/interfaces on the Proxmox host
# Single VLAN-aware bridge - VMs get tagged into VLANs 10/20/30/40 in software

auto lo
iface lo inet loopback

iface eno1 inet manual

auto vmbr0
iface vmbr0 inet static
    address 10.10.10.10/24
    gateway 10.10.10.1
    bridge-ports eno1
    bridge-stp off
    bridge-fd 0
    bridge-vlan-aware yes
    bridge-vids 2-4094
